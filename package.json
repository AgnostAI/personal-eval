  "author": "Agnost AI (https://agnost.ai)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgnostAI/personal-eval.git"
  },
  "homepage": "https://github.com/AgnostAI/personal-eval#readme"
}
